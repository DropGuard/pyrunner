{
  "name": "@dropguard/pyrunner",
  "version": "0.1.22",
  "description": "Lightweight cross-platform Python script scheduler via Bun and uv",
  "license": "MIT",
  "author": "DropGuard <rememberluo@hotmail.com>",
  "homepage": "https://github.com/DropGuard/pyrunner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DropGuard/pyrunner.git"
  },
  "keywords": [
    "python",
    "scheduler",
    "cron",
    "automation",
    "bun",
    "uv",
    "cross-platform"
  ],
  "main": "bin.js",
  "bin": {
    "pyrunner": "bin.js"
  },
  "files": [
    "bin.js"
  ],
  "private": false,
  "scripts": {
    "build": "bun build.ts",
    "build:all": "bun scripts/build-platform.ts windows-x64 && bun scripts/build-platform.ts linux-x64 && bun scripts/build-platform.ts darwin-arm64 && bun scripts/build-platform.ts darwin-x64",
    "test": "bun test",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "preuninstall": "pyrunner uninstall"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/auto-launch": "^5.0.5",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@hono/node-server": "^2.0.2",
    "@inkjs/ui": "^2.0.0",
    "auto-launch": "^5.0.6",
    "commander": "^14.0.3",
    "croner": "^10.0.1",
    "hono": "^4.12.18",
    "ink": "^7.0.2",
    "kysely": "^0.29.0",
    "react": "^19.2.6",
    "tree-kill": "^1.2.2"
  },
  "optionalDependencies": {}
}
